# Copier vers backend/.env pour lancer l'API et Vite a la main (developpement
# local, sans docker-compose pour ces deux-la). Necessite une base MariaDB et
# un MinIO deja demarres (voir docker-compose.dev.yml du depot principal).

DATABASE_URL=mysql+pymysql://audioplayer:audioplayer@localhost:3306/audioplayer?charset=utf8mb4

# Endpoint interne : lister et telecharger les objets.
S3_ENDPOINT=http://localhost:9000
# Base URL par laquelle le NAVIGATEUR joint MinIO.
# En dev, le serveur Vite relaie /s3 vers MinIO : on signe donc pour son
# origine. En production, nginx expose MinIO sous /s3 -> http://mon-hote/s3
S3_PUBLIC_BASE_URL=http://localhost:5173/s3
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=music
S3_PREFIX=

PRESIGN_TTL_SECONDS=3600
COVER_DIR=./data/covers
SCAN_CONCURRENCY=8

# --- Snapcast (facultatif) --------------------------------------------------
# Defauts seulement : l'ecran Configuration de l'application les modifie a
# chaud et les persiste en base, sans redemarrage.
SNAPCAST_ENABLED=false
SNAPCAST_HOST=localhost
SNAPCAST_PORT=1705
SNAPCAST_ADVERTISE_HOST=localhost
SNAPCAST_PORT_START=4960
SNAPCAST_PORT_COUNT=8
