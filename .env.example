# Copier vers backend/.env pour lancer l'API et Vite a la main (developpement
# local, sans docker-compose pour ces deux-la). Necessite une base MariaDB et
# un MinIO deja demarres (voir docker-compose.dev.yml du depot principal).

DATABASE_URL=mysql+pymysql://audioplayer:audioplayer@localhost:3306/audioplayer?charset=utf8mb4

# Endpoint interne : lister et telecharger les objets.
S3_ENDPOINT=http://localhost:9000
# Base URL par laquelle le NAVIGATEUR joint MinIO.
# En dev, le serveur Vite relaie /s3 vers MinIO : on signe donc pour son
# origine. En production, nginx expose MinIO sous /s3 -> http://mon-hote/s3
S3_PUBLIC_BASE_URL=http://localhost:5173/s3
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=music
S3_PREFIX=
# Region annoncee dans la signature SigV4. MinIO accepte n'importe quelle
# valeur ; un vrai S3 exige celle du bucket, sinon la signature est rejetee.
S3_REGION=us-east-1

PRESIGN_TTL_SECONDS=3600
COVER_DIR=./data/covers
SCAN_CONCURRENCY=8

# --- Snapcast (facultatif) --------------------------------------------------
# Defauts seulement : l'ecran Configuration de l'application les modifie a
# chaud et les persiste en base, sans redemarrage.
SNAPCAST_ENABLED=false
SNAPCAST_HOST=localhost
# Port du serveur HTTP de snapserver : il porte le controle JSON-RPC
# (/jsonrpc) comme l'audio (/stream). Seul port de snapserver utilise ; le
# port de controle TCP 1705 ne sert plus.
SNAPCAST_HTTP_PORT=1780
SNAPCAST_ADVERTISE_HOST=localhost
SNAPCAST_PORT_START=4960
SNAPCAST_PORT_COUNT=8

# TLS vers snapserver. Contrairement aux reglages ci-dessus, ceux-ci ne sont
# PAS modifiables depuis l'ecran Configuration : ils ne se changent qu'ici,
# avec un redemarrage. Snapserver ne chiffre pas lui-meme -> suppose un reverse
# proxy TLS devant lui, SNAPCAST_HTTP_PORT pointant sur ce proxy.
SNAPCAST_TLS=false
# Vide = magasin de certificats du systeme ; sinon le certificat de VOTRE
# autorite (indispensable en airgap avec un certificat maison).
SNAPCAST_TLS_CA_FILE=
# Nom verifie contre le certificat et envoye en SNI. Vide = SNAPCAST_HOST ; a
# renseigner si l'on joint le serveur par IP mais que le certificat porte un nom.
SNAPCAST_TLS_SERVER_NAME=
